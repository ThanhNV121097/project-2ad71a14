# Local PostgreSQL username for docker compose.
POSTGRES_USER=app

# Local PostgreSQL password for docker compose only.
POSTGRES_PASSWORD=app_secret

# Local PostgreSQL database name.
POSTGRES_DB=app

# Host port mapped to backend container port 8080.
BACKEND_PORT=8080

# Host port mapped to frontend container port 3000.
FRONTEND_PORT=3000

# Browser-facing backend URL used by frontend build.
NEXT_PUBLIC_API_URL=http://localhost:8080
